// Массив для 20 постов
const posts = [];

for (let i = 1; i <= 20; i++) {
    // Автор: user1, user2, ..., user20
    const author = "user" + i;

    // Год: для user1 -> 2001, user2 -> 2002, ..., user20 -> 2020
    const year = 2000 + i;

    // Месяц и день тоже сделаем разными, чтобы даты внутри года не совпадали
    const month = String((i % 12) + 1).padStart(2, '0'); // от 01 до 12
    const day = String(((i * 3) % 28) + 1).padStart(2, '0'); // от 01 до 28

    const dateString = `${year}-${month}-${day}T10:00:00Z`;

    posts.push({
        "id": i.toString(),
        "author": author,
        "creationDate": dateString,
        "description": "description" + i,
        "photoUrl": "photo" + i
    });
}

// Функция отправки одного поста
function sendPost(post) {
    return new Promise((resolve, reject) => {
        pm.sendRequest({
            url: 'http://localhost:8080/post', // ПРОВЕРЬ URL
            method: 'POST',
            header: {
                'Content-Type': 'application/json'
            },
            body: {
                mode: 'raw',
                raw: JSON.stringify(post)
            }
        }, function (err, res) {
            if (err) {
                console.error("Ошибка при отправке поста " + post.id, err);
                reject(err);
            } else {
                console.log(`Пост ${post.id} | автор: ${post.author} | дата: ${post.creationDate} | статус: ${res.code}`);
                resolve(res);
            }
        });
    });
}

// Последовательная отправка
async function sendAllPosts() {
    for (const post of posts) {
        try {
            await sendPost(post);
        } catch (e) {
            console.error("Прервано на посте " + post.id);
            break;
        }
    }
    console.log("✅ Все 20 постов отправлены!");
}

sendAllPosts();